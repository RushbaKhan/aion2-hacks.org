---
import { DISCORD_INVITE } from '../config/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${DISCORD_INVITE}`} />
    <title>Continuing to Discord</title>
    <script is:inline define:vars={{ dest: DISCORD_INVITE }}>
      window.location.replace(dest);
    </script>
  </head>
  <body>
    <p>Continuing to Discord… <a href={DISCORD_INVITE}>Open Discord</a></p>
  </body>
</html>
