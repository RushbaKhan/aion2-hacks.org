---
import type { SiteFaqItem, FaqTopic } from '../data/faq';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';

interface Props {
  items: SiteFaqItem[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  titleId?: string;
  headingAs?: 'h1' | 'h2';
  showFilters?: boolean;
  filterTopics?: FaqTopic[];
  centered?: boolean;
  /** FAQ column alignment (product pages use left) */
  contentAlign?: 'left' | 'center';
  id?: string;
  class?: string;
}

const {
  items,
  eyebrow = 'FAQ',
  title = 'Straight answers before checkout.',
  subtitle = 'Compatibility, bans and access—no vague promises.',
  titleId = 'faq-heading',
  headingAs = 'h2',
  showFilters = false,
  filterTopics,
  centered = true,
  contentAlign = 'center',
  id: sectionId,
  class: className,
} = Astro.props;

const topicLabels: Record<FaqTopic, string> = {
  all: 'All',
  plans: 'Plans',
  esp: 'ESP',
  aim: 'Aim',
  safety: 'Safety',
  blog: 'Blog',
  setup: 'Setup',
};

const filters = filterTopics ?? (['all', 'plans', 'esp', 'aim', 'safety', 'setup'] as FaqTopic[]);
---

<section
  id={sectionId}
  class:list={['py-16 md:py-24', className]}
  aria-labelledby={titleId}
  data-faq-section
>
  <div class="mx-auto max-w-6xl px-5">
    <div class:list={[contentAlign === 'center' && 'mx-auto max-w-3xl', contentAlign === 'left' && 'product-detail__narrow max-w-3xl']}>
    <SectionHeader
      as={headingAs}
      eyebrow={eyebrow}
      title={title}
      desc={subtitle}
      titleId={titleId}
      centered={centered}
    />

    <div
      class:list={[
        'mt-8 flex flex-col gap-3',
        contentAlign === 'center' ? 'items-center' : 'items-start',
      ]}
    >
      <label class="listing-search">
        <Icon name="search" size={16} />
        <input type="search" placeholder="Search FAQ" aria-label="Search FAQ" data-faq-search />
      </label>
      {
        showFilters && (
          <div
            class:list={[
              'flex flex-wrap gap-2',
              contentAlign === 'center' ? 'justify-center' : 'justify-start',
            ]}
            data-faq-filters
          >
            {filters.map((topic, i) => (
              <button
                type="button"
                class:list={[
                  'faq-filter-chip inline-flex min-h-12 min-w-12 items-center rounded-full border border-border px-3 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:border-primary hover:text-foreground',
                  { 'is-active': i === 0 },
                ]}
                data-faq-filter={topic}
              >
                {topicLabels[topic]}
              </button>
            ))}
          </div>
        )
      }
    </div>

    <div class="mt-8 w-full divide-y divide-border overflow-hidden rounded-2xl border border-border" data-faq-list>
      {items.map((faq) => (
        <details
          class="group bg-card open:bg-card"
          data-faq-topic={faq.topic}
          data-faq-search-text={`${faq.q} ${faq.a}`}
        >
          <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-4 text-left text-sm font-medium marker:content-none [&::-webkit-details-marker]:hidden">
            <Icon name={faq.icon} size={16} class="shrink-0" />
            <span class="flex-1">{faq.q}</span>
            <Icon name="chevronDown" size={16} class="shrink-0 transition-transform group-open:rotate-180" />
          </summary>
          <div class="px-4 pb-4">
            <div class="prose prose-sm dark:prose-invert max-w-none text-muted-foreground" set:html={faq.aHtml ?? faq.a} />
          </div>
        </details>
      ))}
    </div>
    </div>
  </div>
</section>
