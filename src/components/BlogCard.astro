---
import ResponsiveImage from './ResponsiveImage.astro';
import Icon from './icons/Icon.astro';
import { CARD_IMAGE_SIZES, CARD_IMAGE_WIDTHS } from '../utils/responsiveImage';
import { blogPostPath } from '../utils/path';
import type { BlogPost } from '../i18n/types';
import { t } from '../i18n';
import { getBlogPostTimestamp, getBlogReadMinutes } from '../data/blog';
import { blogTagIcons } from '../data/sectionIcons';
import type { IconName } from './icons/types';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Card, CardContent, CardFooter, CardTitle } from '@/components/starwind/card';

interface Props {
  post: BlogPost;
  index?: number;
  eager?: boolean;
  /** Show date on image (blog index grid) */
  showDate?: boolean;
  /** Full-width split hero on blog index — same card UI as grid cards */
  layout?: 'default' | 'featured';
  class?: string;
}

const { post, index = 0, eager = false, showDate = false, layout = 'default', class: className } =
  Astro.props;
const isFeatured = layout === 'featured';
const href = blogPostPath(post.slug);
const timestamp = getBlogPostTimestamp(post.date);
const readMinutes = getBlogReadMinutes(post.readTime);
const tagIcon: IconName = blogTagIcons[post.tag] ?? 'tag';
---

<Card
  size="sm"
  class:list={[
    'blog-card group/card gap-0 overflow-hidden py-0 pt-0 shadow-xs hover:shadow-md has-data-[slot=card-footer]:pb-0',
    isFeatured
      ? 'blog-featured mt-8 md:mt-10 lg:grid lg:grid-cols-[1.05fr_0.95fr] lg:items-stretch'
      : 'flex h-full flex-col',
    className,
  ]}
  data-blog-card
  data-tag={post.tag}
  data-ts={timestamp}
  data-read-minutes={readMinutes}
>
  <a
    href={href}
    class:list={[
      'relative block aspect-video overflow-hidden focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-primary/40 focus-visible:ring-offset-2 focus-visible:ring-offset-card',
      isFeatured && 'lg:aspect-auto lg:min-h-[16rem] lg:self-stretch',
    ]}
    tabindex="-1"
    aria-hidden="true"
  >
    <ResponsiveImage
      src={post.image}
      alt=""
      width={isFeatured ? 960 : 640}
      height={isFeatured ? 540 : 360}
      widths={isFeatured ? undefined : CARD_IMAGE_WIDTHS}
      sizes={isFeatured ? '(min-width: 1024px) 560px, 100vw' : CARD_IMAGE_SIZES}
      loading={eager || index < 3 ? 'eager' : 'lazy'}
      fetchPriority={eager || index === 0 ? 'high' : undefined}
      class:list={[
        'size-full object-cover transition-transform duration-500 ease-out group-hover/card:scale-[1.03]',
        isFeatured && 'lg:absolute lg:inset-0 lg:aspect-auto',
      ]}
    />

    <div class="pointer-events-none absolute inset-x-0 top-0 flex items-start justify-between gap-2 p-3">
      <Badge
        tone="neutral"
        appearance="frosted"
        size="sm"
        class="gap-1.5 shadow-sm"
      >
        <Icon name={tagIcon} size={14} />
        {post.tag}
      </Badge>
      {
        showDate ? (
          <Badge tone="neutral" appearance="frosted" size="sm" class="gap-1.5 shadow-sm">
            <Icon name="calendar" size={14} />
            {post.date}
          </Badge>
        ) : (
          <Badge tone="neutral" appearance="frosted" size="sm" class="gap-1.5 shadow-sm">
            <Icon name="clock" size={14} />
            {post.readTime}
          </Badge>
        )
      }
    </div>

    <span
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover/card:opacity-100"
      aria-hidden="true"
    />
  </a>

  <div class:list={[isFeatured && 'flex min-h-0 flex-col lg:border-l lg:border-border']}>
  <CardContent
    class:list={[
      'flex flex-1 flex-col gap-2.5 p-4 pb-3',
      isFeatured && 'justify-center border-t border-border p-5 sm:p-6 lg:border-t-0 lg:py-6 lg:pl-8 lg:pr-6',
    ]}
  >
    <CardTitle class="text-base font-semibold normal-case leading-snug tracking-tight md:text-[1.0625rem]">
      <a
        href={href}
        class="text-foreground decoration-primary/0 underline-offset-4 transition-colors hover:text-primary hover:underline"
      >
        {post.title}
      </a>
    </CardTitle>

    <p
      class:list={[
        'text-sm leading-relaxed text-muted-foreground',
        isFeatured ? 'line-clamp-4 md:line-clamp-5' : 'line-clamp-2',
      ]}
    >
      {post.desc}
    </p>
  </CardContent>

  <CardFooter class="blog-card__footer mt-auto border-t px-4 py-3 lg:px-6">
    <p class="blog-card__footer-meta text-sm text-muted-foreground">
      {showDate ? (
        <>
          <Icon name="calendar" size={14} class="inline-block align-[-2px]" aria-hidden="true" />
          <span class="ml-1.5">{post.date}</span>
          <span class="mx-2 text-border" aria-hidden="true">
            ·
          </span>
        </>
      ) : null}
      <Icon name="clock" size={14} class="inline-block align-[-2px]" aria-hidden="true" />
      <span class="ml-1.5">{post.readTime}</span>
    </p>
    <Button as="a" href={href} variant="outline" size="sm" class="blog-card__read shrink-0">
      {t.blog.read}
      <Icon name="arrowRight" size={16} />
    </Button>
  </CardFooter>
  </div>
</Card>
