---
import '../styles/site-search.css';
import Icon from './icons/Icon.astro';
import { ROUTES } from '../utils/path';
import { t } from '../i18n';

interface Props {
  variant?: 'header' | 'sheet';
  class?: string;
}

const { variant = 'header', class: className } = Astro.props;
---

<div class:list={['site-search', `site-search--${variant}`, className]} data-site-search>
  <button
    type="button"
    class="site-search__toggle"
    data-site-search-toggle
    aria-expanded="false"
    aria-controls={variant === 'header' ? 'site-search-panel' : 'site-search-panel-sheet'}
    aria-label={t.ui.searchSite}
  >
    <Icon name="search" size={16} />
    <span class:list={[variant === 'header' ? 'hidden min-[1600px]:ml-1.5 min-[1600px]:inline' : undefined]}>{t.ui.search}</span>
  </button>

  <div
    id={variant === 'header' ? 'site-search-panel' : 'site-search-panel-sheet'}
    class="site-search__panel"
    data-site-search-panel
    hidden
  >
    <form class="site-search__form" action={ROUTES.search} method="get" role="search">
      <label class="site-search__field">
        <Icon name="search" size={16} />
        <input
          type="search"
          name="q"
          placeholder={t.ui.searchPlaceholder}
          aria-label={t.ui.searchSite}
          autocomplete="off"
          data-site-search-input
        />
      </label>
      <button type="submit" class="sr-only">{t.ui.search}</button>
    </form>
    <p class="site-search__hint">{t.ui.searchHint}</p>
    <ul class="site-search__results" data-site-search-results role="listbox" aria-label={t.ui.searchResults}></ul>
    <p class="site-search__empty" data-site-search-empty hidden>{t.ui.searchEmpty}</p>
  </div>
</div>
