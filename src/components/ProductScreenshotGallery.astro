---
import type { ProductSlide } from '../data/products';
import Icon from './icons/Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import {
  defaultWebpSrc,
  THUMB_IMAGE_WIDTHS,
} from '../utils/responsiveImage';

interface Props {
  images: ProductSlide[];
  id?: string;
  compact?: boolean;
}

const { images, id = 'product-screenshots', compact = false } = Astro.props;
const hasThumbs = images.length > 1;
const first = images[0];
---

<div
  class:list={[
    'product-gallery',
    !hasThumbs && 'product-gallery--single',
    compact && 'product-gallery--compact',
  ]}
  id={id}
  data-product-gallery
>
  <div class="product-gallery__stage relative min-w-0 overflow-hidden rounded-xl border border-border bg-muted/20">
    <div class="product-gallery__main cursor-zoom-in overflow-hidden">
      {
        first && (
          <ResponsiveImage
            src={first.src}
            alt={first.alt}
            width={1024}
            height={574}
            widths={[400]}
            loading="eager"
            fetchPriority="high"
            sizes={compact ? '(min-width: 768px) 560px, 92vw' : '(min-width: 1024px) 400px, 92vw'}
            class="product-gallery__image w-full object-cover"
          />
        )
      }
    </div>
    {
      hasThumbs && (
        <>
          <button
            type="button"
            class="slide-nav slide-nav--prev"
            data-product-gallery-prev
            aria-label="Previous screenshot"
          >
            <Icon name="chevronLeft" size={18} />
          </button>
          <button
            type="button"
            class="slide-nav slide-nav--next"
            data-product-gallery-next
            aria-label="Next screenshot"
          >
            <Icon name="chevronRight" size={18} />
          </button>
        </>
      )
    }
  </div>

  {
    hasThumbs && (
      <div class="product-gallery__thumbs" role="group" aria-label="Product screenshots" data-lenis-prevent>
        {images.map((img, i) => (
          <button
            type="button"
            class:list={['product-gallery__thumb', i === 0 && 'is-active']}
            aria-current={i === 0 ? 'true' : undefined}
            aria-label={`Screenshot ${i + 1}`}
            data-product-gallery-thumb
            data-index={i}
            data-src={defaultWebpSrc(img.src, [400])}
            data-srcset=""
            data-alt={img.alt}
          >
            <img
              alt={img.alt}
              width="320"
              height="180"
              decoding="async"
              class="size-full object-cover"
              data-thumb-src={defaultWebpSrc(img.src, THUMB_IMAGE_WIDTHS)}
            />
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  const initProductGalleries = () => {
    document.querySelectorAll('[data-product-gallery]').forEach((root) => {
      if (root.hasAttribute('data-gallery-bound')) return;
      root.setAttribute('data-gallery-bound', '');

      const main = root.querySelector<HTMLImageElement>('.product-gallery__image');
      const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-product-gallery-thumb]')];
      const prev = root.querySelector<HTMLButtonElement>('[data-product-gallery-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-product-gallery-next]');
      const hydrateThumbs = () => {
        root.querySelectorAll<HTMLImageElement>('[data-thumb-src]').forEach((img) => {
          const src = img.getAttribute('data-thumb-src');
          if (!src) return;
          img.src = src;
          img.removeAttribute('data-thumb-src');
        });
      };
      if (document.readyState === 'complete') {
        window.setTimeout(hydrateThumbs, 400);
      } else {
        window.addEventListener('load', () => window.setTimeout(hydrateThumbs, 400), { once: true });
      }
      if (!main || !thumbs.length) return;

      let index = 0;

      const select = (nextIndex: number) => {
        index = (nextIndex + thumbs.length) % thumbs.length;
        const thumb = thumbs[index];
        if (!thumb) return;

        const alt = thumb.getAttribute('data-alt');
        const fullSrc = thumb.getAttribute('data-src');
        const fullSrcset = thumb.getAttribute('data-srcset');
        const pictureSource = root.querySelector<HTMLSourceElement>('.product-gallery__main source');
        if (fullSrc) main.src = fullSrc;
        if (fullSrcset) {
          main.srcset = fullSrcset;
          if (pictureSource) pictureSource.srcset = fullSrcset;
        } else {
          main.removeAttribute('srcset');
          pictureSource?.removeAttribute('srcset');
        }
        if (alt) main.alt = alt;
        thumbs.forEach((t, i) => {
          const active = i === index;
          t.classList.toggle('is-active', active);
          if (active) t.setAttribute('aria-current', 'true');
          else t.removeAttribute('aria-current');
        });
        thumb.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      };

      thumbs.forEach((thumb, i) => {
        thumb.addEventListener('click', () => select(i));
      });
      prev?.addEventListener('click', () => select(index - 1));
      next?.addEventListener('click', () => select(index + 1));
    });
  };

  initProductGalleries();
  document.addEventListener('astro:after-swap', initProductGalleries);
</script>
