---
import ResponsiveImage from './ResponsiveImage.astro';
import Icon from './icons/Icon.astro';
import {
  HERO_IMAGE_SIZES,
  HERO_IMAGE_WIDTHS,
  avifSrcSet,
  defaultWebpSrc,
  imageSrcSet,
} from '../utils/responsiveImage';

interface Slide {
  src: string;
  alt: string;
  caption: string;
  captionDesc: string;
}

interface Props {
  images: Slide[];
  id: string;
  variant?: 'default' | 'hero';
  desktopOnly?: boolean;
}

const { images, id, desktopOnly = false } = Astro.props;
---

<div
  class:list={[
    'relative min-w-0 w-full max-w-full overflow-hidden rounded-xl border border-border bg-card p-2 shadow-sm',
    desktopOnly && 'hidden lg:block',
  ]}
  id={id}
  data-hero-slider-wrap
>
  <div class="w-full overflow-hidden" data-hero-slider>
    <div class="flex" data-hero-slider-track>
      {images.map((img, i) => (
        <figure
          class="hero-slider-slide aspect-[16/10] w-full shrink-0 overflow-hidden rounded-lg bg-muted/30"
          data-slide-src={defaultWebpSrc(img.src, HERO_IMAGE_WIDTHS)}
          data-slide-srcset={imageSrcSet(img.src, HERO_IMAGE_WIDTHS) ?? ''}
          data-slide-avifset={avifSrcSet(img.src, HERO_IMAGE_WIDTHS) ?? ''}
          data-slide-alt={img.alt}
          data-slide-sizes={HERO_IMAGE_SIZES}
        >
          {i === 0 && (
            <ResponsiveImage
              src={img.src}
              alt={img.alt}
              width={3840}
              height={2160}
              widths={HERO_IMAGE_WIDTHS}
              loading={desktopOnly ? 'lazy' : 'eager'}
              fetchPriority={desktopOnly ? 'low' : 'high'}
              sizes={HERO_IMAGE_SIZES}
              desktopOnly={desktopOnly}
              class="h-full w-full object-cover"
            />
          )}
        </figure>
      ))}
    </div>
  </div>
  {images.length > 1 && (
    <>
      <button type="button" class="slide-nav slide-nav--prev" data-hero-slider-prev aria-label="Previous screenshot">
        <Icon name="chevronLeft" size={18} />
      </button>
      <button type="button" class="slide-nav slide-nav--next" data-hero-slider-next aria-label="Next screenshot">
        <Icon name="chevronRight" size={18} />
      </button>
      <div class="pointer-events-none absolute inset-x-3 bottom-2.5 flex justify-center">
        <div class="pointer-events-auto flex max-w-full items-center gap-px rounded-full border border-white/10 bg-black/50 px-1.5 py-0.5 backdrop-blur-sm" role="group" aria-label="Hero slides">
          {images.map((_, i) => (
            <button
              type="button"
              class="hero-embla-dot relative shrink-0 overflow-hidden rounded-full"
              data-hero-slider-dot={i}
              aria-label={`Slide ${i + 1}`}
              aria-current={i === 0 ? 'true' : undefined}
              data-active={i === 0 ? 'true' : 'false'}
            >
              <span class="hero-embla-dot__pip" aria-hidden="true">
                <span
                  class="hero-embla-progress pointer-events-none absolute inset-y-0 left-0 rounded-full bg-primary-accent"
                  data-hero-slider-progress
                />
              </span>
            </button>
          ))}
        </div>
      </div>
    </>
  )}
</div>

