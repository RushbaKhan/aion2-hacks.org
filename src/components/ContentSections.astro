---
import { t } from '../i18n';
import { getFeaturedBlogPosts } from '../data/blog';
import WorkflowSection from './WorkflowSection.astro';
import SectionHeader from './SectionHeader.astro';
import BlogCard from './BlogCard.astro';
import Icon from './icons/Icon.astro';
import { ROUTES } from '../utils/path';
import SiteFaqSection from './SiteFaqSection.astro';
import { getLandingFaqs } from '../data/faq';
import { Button } from '@/components/starwind/button';

const homeFaqs = getLandingFaqs();
const featuredPosts = getFeaturedBlogPosts(3);
---

<WorkflowSection />

<section id="blog" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="blog-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader as="h2" eyebrow={t.blog.eyebrow} title={t.blog.title} desc={t.blog.subtitle} titleId="blog-title" />

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-10">
      {featuredPosts.map((post, i) => (
        <BlogCard post={post} index={i} />
      ))}
    </div>

    <div class="mt-10 flex flex-wrap justify-start gap-3 lg:justify-center">
      <Button as="a" href={ROUTES.blog} variant="outline">
        {t.blog.viewAll}
        <Icon name="arrowRight" size={17} />
      </Button>
      <Button as="a" href={ROUTES.forum} variant="outline">
        Open forum
      </Button>
      <Button as="a" href={ROUTES.store} variant="outline">
        View store
      </Button>
    </div>
  </div>
</section>

<nav class="border-y border-border bg-muted/10 py-12 md:py-16" aria-label="Explore Overwatch Cheat">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      as="h2"
      eyebrow="Explore"
      title="Every Overwatch Cheat page stays one click away"
      desc="Overwatch Cheats pages for Overwatch 2: plans, overlays, setup, status, Overwatch characters, patch notes, and ranks."
      titleId="explore-title"
    />
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { href: ROUTES.features, title: 'Overwatch 2 features', desc: 'Aimbot, player ESP, radar, and hero ESP.' },
        { href: ROUTES.store, title: 'Overwatch Cheats store', desc: 'Monthly $35 and lifetime $150 plans.' },
        { href: ROUTES.dma, title: 'Cloud DMA', desc: 'Extra that runs with Overwatch Cheats.' },
        { href: ROUTES.hwid, title: 'HWID Spoofer', desc: 'Extra that runs with Overwatch Cheats.' },
        { href: '/ow2/', title: 'Overwatch 2', desc: 'Release date, download, Steam charts, player count.' },
        { href: '/heroes/', title: 'Overwatch characters', desc: 'OW characters and Overwatch 2 heroes.' },
        { href: '/patch/', title: 'Overwatch patch notes', desc: 'Season timing and Overwatch 2 patch notes.' },
        { href: '/ranks/', title: 'Overwatch ranks', desc: 'Overwatch 2 ranks and challenger score.' },
        { href: '/juno/', title: 'Juno Overwatch', desc: 'Support hero notes and hero ESP.' },
        { href: '/dva/', title: 'D.Va Overwatch', desc: 'D.Va Overwatch vs Overwatch 2 reads.' },
        { href: '/skins/', title: 'Overwatch 2 skins', desc: 'Battle pass cosmetics, not cheat modules.' },
        { href: '/tier/', title: 'Overwatch 2 tier list', desc: 'New hero drops vs the store list.' },
        { href: '/cross/', title: 'Cross platform', desc: 'Is Overwatch 2 cross platform on PC.' },
        { href: '/blizzard/', title: 'OW / .ow / أوفرواتش', desc: 'Blizzard naming for the same game.' },
        { href: '/esp/', title: 'Player ESP', desc: 'Box, skeleton, health, and distance.' },
        { href: '/aim/', title: 'Overwatch aimbot', desc: 'Aim assist, silent aim, triggerbot.' },
      ].map((item) => (
        <li>
          <a
            href={item.href}
            class="block h-full rounded-2xl border border-border bg-card/80 px-4 py-4 transition-colors hover:border-primary/40"
          >
            <p class="font-semibold text-foreground">{item.title}</p>
            <p class="mt-1 text-sm text-muted-foreground">{item.desc}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<SiteFaqSection id="faq" titleId="faq-title" items={homeFaqs} />
