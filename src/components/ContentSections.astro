---
import { t } from '../i18n';
import { getFeaturedBlogPosts } from '../data/blog';
import WorkflowSection from './WorkflowSection.astro';
import SectionHeader from './SectionHeader.astro';
import BlogCard from './BlogCard.astro';
import Icon from './icons/Icon.astro';
import { ROUTES } from '../utils/path';
import SiteFaqSection from './SiteFaqSection.astro';
import { getLandingFaqs } from '../data/faq';
import { Button } from '@/components/starwind/button';

const homeFaqs = getLandingFaqs();
const featuredPosts = getFeaturedBlogPosts(3);
---

<WorkflowSection />

<section id="blog" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="blog-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader as="h2" eyebrow={t.blog.eyebrow} title={t.blog.title} desc={t.blog.subtitle} titleId="blog-title" />

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-10">
      {featuredPosts.map((post, i) => (
        <BlogCard post={post} index={i} />
      ))}
    </div>

    <div class="mt-10 flex flex-wrap justify-start gap-3 lg:justify-center">
      <Button as="a" href={ROUTES.blog} variant="outline">
        {t.blog.viewAll}
        <Icon name="arrowRight" size={17} />
      </Button>
      <Button as="a" href={ROUTES.forum} variant="outline">
        Open forum
      </Button>
      <Button as="a" href={ROUTES.store} variant="outline">
        View store
      </Button>
    </div>
  </div>
</section>

<nav class="border-y border-border bg-muted/10 py-12 md:py-16" aria-label="Explore Aion 2 Hacks" data-no-i18n>
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      as="h2"
      eyebrow="Aion 2 only"
      title="Aion 2 Hacks pages, one click away"
      desc="Plans, overlays, setup, status, and guides for Aion 2 on Windows PC. No other games."
      titleId="explore-title"
    />
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { href: ROUTES.features, title: 'Aion 2 features', desc: 'Aimbot, player ESP, radar, and target overlays.' },
        { href: ROUTES.store, title: 'Aion 2 Hacks store', desc: 'Weekly $15, monthly $35, and lifetime $150.' },
        { href: ROUTES.dma, title: 'Cloud DMA', desc: 'Extra that runs with Aion 2 Hacks.' },
        { href: ROUTES.hwid, title: 'HWID Spoofer', desc: 'Extra that runs with Aion 2 Hacks.' },
        { href: '/cheats/', title: 'Hacks overview', desc: 'Listed modules to review before checkout.' },
        { href: '/esp/', title: 'Player ESP', desc: 'Box, skeleton, health, name, and distance.' },
        { href: '/radar/', title: 'Radar', desc: '2D and 3D local awareness next to ESP.' },
        { href: '/aim/', title: 'Aimbot', desc: 'Aim assist, silent aim, and triggerbot.' },
        { href: '/plans/', title: 'Compare plans', desc: 'Weekly vs monthly vs lifetime access.' },
        { href: ROUTES.status, title: 'Status', desc: 'Compatibility notes after Aion 2 patches.' },
        { href: ROUTES.setup, title: 'Windows PC setup', desc: 'First-run order for the official client.' },
        { href: '/pc/', title: 'PC requirements', desc: 'Windows 10/11 and overlay launch notes.' },
        { href: '/ac/', title: 'Anti-cheat notes', desc: 'Unverified NCSOFT compatibility context.' },
        { href: ROUTES.faq, title: 'FAQ', desc: 'Plans, features, setup, and checkout answers.' },
        { href: ROUTES.blog, title: 'Guides', desc: 'Classes, overlays, and patch-day articles.' },
        { href: ROUTES.forum, title: 'Community forum', desc: 'Practical answers from the Aion 2 listing.' },
      ].map((item) => (
        <li>
          <a
            href={item.href}
            class="block h-full rounded-2xl border border-border bg-card/80 px-4 py-4 transition-colors hover:border-primary/40"
          >
            <p class="font-semibold text-foreground">{item.title}</p>
            <p class="mt-1 text-sm text-muted-foreground">{item.desc}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<SiteFaqSection id="faq" titleId="faq-title" items={homeFaqs} />
