---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../utils/schema';
import { CARD_IMAGE_WIDTHS, webpSrc } from '../utils/responsiveImage';
import { blogPosts, getBlogListing, getBlogTags } from '../data/blog';
import { screenshotAlt } from '../data/screenshots';
import { ROUTES, blogTopicPath } from '../utils/path';
import { blogTagIcons } from '../data/sectionIcons';
import type { IconName } from './icons/types';
import Breadcrumbs from './Breadcrumbs.astro';
import BlogCard from './BlogCard.astro';
import BlogSortSelect from './BlogSortSelect.astro';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import '../styles/site-search.css';

interface Props {
  tag?: string | 'all';
}

const { tag = 'all' } = Astro.props;
const activeTag = tag === 'all' ? 'all' : tag;
const path = activeTag === 'all' ? ROUTES.blog : blogTopicPath(activeTag);
const seo = resolvePageSeo(path);
const tags = getBlogTags();
const { featured, grid } = getBlogListing(activeTag);
const listingTitle = activeTag === 'all' ? t.blog.latestTitle : `${activeTag} articles`;
const listingSubtitle =
  activeTag === 'all' ? t.blog.latestSubtitle : `Isle Hacks articles tagged ${activeTag}.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: ROUTES.blog },
  ...(activeTag === 'all' ? [] : [{ name: activeTag, path }]),
];

const lcpImage = webpSrc(featured?.image ?? blogPosts[0]!.image, CARD_IMAGE_WIDTHS[0]);
const tagIcon = (value: string): IconName => blogTagIcons[value] ?? 'tag';
const filters = [{ label: t.blog.filterAll, value: 'all' as const }, ...tags.map((value) => ({ label: value, value }))];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={featured?.image ?? blogPosts[0]!.image}
  ogImageAlt={screenshotAlt(featured?.image ?? blogPosts[0]!.image)}
  jsonLd={[
    collectionPageSchema({
      name: listingTitle,
      description: listingSubtitle,
      url: path,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <link slot="head" rel="preload" as="image" href={lcpImage} type="image/webp" fetchpriority="high" />

  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      {featured && <BlogCard post={featured} index={0} eager showDate layout="featured" />}
    </div>
  </section>

  <section class="border-y border-border bg-muted/20 py-12 md:py-16" aria-labelledby="blog-latest-title">
    <div class="mx-auto max-w-6xl px-5">
      <header class="section-header max-w-2xl">
        <p class="section-header__eyebrow">{t.blog.eyebrow}</p>
        <h1 id="blog-latest-title" class="section-header__title">{listingTitle}</h1>
        <p class="section-header__subtitle">{listingSubtitle}</p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          Start with the <a href={ROUTES.store}>store</a> for plans, the <a href={ROUTES.features}>features</a> list for modules,
          and the <a href={ROUTES.status}>status</a> page after an Evrima patch. The
          <a href="/the-isle-esp-terminology/">ESP glossary</a> and
          <a href="/the-isle-hacks-evrima/">Evrima overview</a> are the usual first reads.
        </p>
      </header>

      <div class="mt-8 flex flex-col gap-4 lg:mt-10 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
        <nav
          class="flex gap-2 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          aria-label="Article topics"
        >
          {
            filters.map((filter) => {
              const href = filter.value === 'all' ? ROUTES.blog : blogTopicPath(filter.value);
              const current = filter.value === activeTag;
              return (
                <a
                  href={href}
                  class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
                  aria-current={current ? 'page' : undefined}
                  data-active={current ? 'true' : undefined}
                >
                  <span class="flex size-7 items-center justify-center rounded-full bg-muted text-primary" aria-hidden="true">
                    <Icon name={filter.value === 'all' ? 'navBlog' : tagIcon(filter.value)} size={15} />
                  </span>
                  {filter.label}
                </a>
              );
            })
          }
        </nav>

        <div class="flex w-full flex-col gap-3 sm:flex-row sm:items-end lg:w-auto">
          <label class="listing-search">
            <Icon name="search" size={16} />
            <input type="search" placeholder="Search articles" aria-label="Search articles" data-listing-search />
          </label>
          <BlogSortSelect />
        </div>
      </div>

      <div id="blog-grid" class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-10">
        {grid.map((post, index) => (
          <BlogCard post={post} index={index} showDate />
        ))}
      </div>

      <p
        id="blog-empty"
        class="mt-10 hidden text-center text-muted-foreground"
        role="status"
        data-empty={t.blog.emptyFilter}
      >
        {t.blog.emptyFilter}
      </p>

      <div class="mt-12 flex flex-wrap justify-start gap-3 lg:justify-center">
        <Button as="a" href={ROUTES.home} variant="outline">
          <Icon name="chevronLeft" size={16} />
          Back to home
        </Button>
        <Button as="a" href={ROUTES.store} variant="outline">View store</Button>
        <Button as="a" href={ROUTES.faq} variant="outline">Read FAQ</Button>
      </div>
    </div>
  </section>

  <script>
    import { initBlogIndexFilters } from '../scripts/blog-index.ts';

    const emptyMessage =
      document.getElementById('blog-empty')?.dataset.empty ?? 'No articles match this filter.';

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initBlogIndexFilters(emptyMessage));
    } else {
      initBlogIndexFilters(emptyMessage);
    }
  </script>
</BaseLayout>
