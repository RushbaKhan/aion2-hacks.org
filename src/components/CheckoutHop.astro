---
import { CHECKOUT, type CheckoutProduct } from '../config/checkout';

interface Props {
  product?: CheckoutProduct;
}

const { product = 'aion2' } = Astro.props;
const dest = CHECKOUT[product];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${dest}`} />
    <title>Continuing to checkout</title>
    <script is:inline define:vars={{ dest }}>
      window.location.replace(dest);
    </script>
  </head>
  <body>
    <p>Continuing to checkout… <a href={dest}>Open checkout</a></p>
  </body>
</html>
