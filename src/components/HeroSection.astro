---
import { t } from '../i18n';
import { ROUTES } from '../utils/path';
import { heroSlides } from '../data/products';
import { compatibilityIcons, heroStatIcons, heroStatusPills } from '../data/sectionIcons';
import ImageSlider from './ImageSlider.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Badge } from '@/components/starwind/badge';

const h = t.hero;

const heroMarqueePills = [
  ...heroStatusPills,
  ...t.compatibility.items.map((label, i) => ({
    label,
    icon: compatibilityIcons[i] ?? 'check',
  })),
];
---

<section
  id="hero"
  class="relative overflow-hidden border-b border-border"
  aria-labelledby="hero-title"
>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,var(--primary)_0%,transparent_58%)] opacity-40" aria-hidden="true" />

  <div class="relative mx-auto flex max-w-6xl flex-col justify-center px-5">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="flex min-h-[100svh] w-full max-w-xl flex-col justify-center space-y-6 text-left md:space-y-7 lg:min-h-0 lg:max-w-2xl">
        <Badge variant="secondary" class="uppercase tracking-wider">{h.eyebrow}</Badge>

        <h1 id="hero-title" class="text-5xl font-bold uppercase leading-tight md:text-6xl [font-family:ui-sans-serif,system-ui,sans-serif]">
          <span class="block text-primary-accent">{h.titleLine2}</span>
          <span class="mt-2 block text-lg font-semibold uppercase tracking-[0.14em] text-foreground md:text-xl">
            {h.titleLine3}
          </span>
        </h1>

        <p class="max-w-xl text-sm leading-relaxed text-muted-foreground line-clamp-2 md:text-base md:line-clamp-none">
          {h.subtitle}
        </p>
        <p class="max-w-xl text-sm leading-relaxed text-muted-foreground line-clamp-2 md:line-clamp-none">
          {t.ui.startWithThe} <a href={ROUTES.features} class="font-medium text-primary-accent hover:underline">{t.ui.featuresList}</a>,
          {t.ui.compareWord} <a href={ROUTES.store} class="font-medium text-primary-accent hover:underline">{t.ui.monthlyLifetime}</a>,
          {t.ui.thenCheck} <a href={ROUTES.status} class="font-medium text-primary-accent hover:underline">{t.ui.currentStatus}</a>
          {t.ui.andWord} <a href={ROUTES.setup} class="font-medium text-primary-accent hover:underline">{t.ui.windowsSetup}</a> {t.ui.beforeCheckout}
        </p>

        <div class="flex flex-wrap justify-start gap-3 sm:gap-4">
          <Button
            as="a"
            href={ROUTES.store}
            variant="primary"
            size="lg"
            class="rounded-xl"
          >
            {h.ctaPrimary}
            <Icon name="arrowRight" size={18} />
          </Button>
          <Button
            as="a"
            href={ROUTES.store}
            variant="secondary"
            size="lg"
            class="rounded-xl"
          >
            <Icon name="layers" size={18} />
            {h.ctaDiscord}
          </Button>
        </div>
      </div>

      <div class="mx-auto flex w-full min-w-0 max-w-xl flex-col items-center gap-5 lg:mx-0 lg:max-w-none lg:items-end" data-defer-paint>
        {heroSlides[0] && (
          <div class="w-full overflow-hidden rounded-xl border border-border bg-card p-2 shadow-sm lg:hidden">
            <ResponsiveImage
              src={heroSlides[0].src}
              alt={heroSlides[0].alt}
              width={3840}
              height={2160}
              widths={[960, 1920, 3840]}
              sizes="92vw"
              loading="lazy"
              fetchPriority="low"
              mobileOnly
              class="h-auto w-full rounded-lg object-cover"
            />
          </div>
        )}
        <ImageSlider images={heroSlides} id="hero-slider" variant="hero" desktopOnly />
        <div class="grid w-full grid-cols-2 gap-2.5 sm:gap-3 md:grid-cols-4 lg:grid-cols-2">
          {h.metrics.map((m, i) => (
            <div class="flex min-w-0 items-center gap-3 rounded-xl border border-border/80 bg-card/70 px-3 py-3 shadow-sm shadow-black/10 transition-colors hover:border-primary/40">
              <span
                class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/15 ring-1 ring-inset ring-primary/25"
                aria-hidden="true"
              >
                <Icon name={heroStatIcons[i] ?? 'check'} size={18} />
              </span>
              <div class="min-w-0">
                <p class="font-[family-name:var(--font-heading)] text-base font-bold leading-none tracking-tight text-foreground">{m.strong}</p>
                <p class="mt-1 text-xs leading-tight text-muted-foreground">{m.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="hero-status-marquee relative mt-10 md:mt-12 lg:mt-14" aria-hidden="true" data-defer-paint>
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 bg-gradient-to-r from-background to-transparent" />
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-background to-transparent" />
      <div class="hero-status-marquee-track flex w-max gap-2">
        {heroMarqueePills.map((pill) => (
          <Badge variant="outline" class="group/badge shrink-0 gap-1 py-0.5 pl-1.5 pr-2.5 text-xs whitespace-nowrap">
            <Icon name={pill.icon} size={13} />
            {pill.label}
          </Badge>
        ))}
      </div>
    </div>
  </div>
</section>
