---
import { LOCALES } from '../i18n/locales';
import { t } from '../i18n';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['lang-switch', className]} data-lang-switch>
  <label class="sr-only">{t.ui.language}</label>
  <select class="lang-switch__select" data-lang-select aria-label={t.ui.changeLanguage}>
    {LOCALES.map((locale) => (
      <option value={locale.code}>{locale.label}</option>
    ))}
  </select>
</div>

<style>
  .lang-switch {
    position: relative;
  }

  .lang-switch__select {
    appearance: none;
    min-height: 2.75rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in oklch, var(--border) 80%, transparent);
    background: color-mix(in oklch, var(--background) 55%, transparent);
    padding: 0.35rem 1.75rem 0.35rem 0.7rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--foreground);
    cursor: pointer;
  }

  .lang-switch::after {
    content: '';
    position: absolute;
    right: 0.55rem;
    top: 50%;
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
    opacity: 0.7;
  }

  html[dir='rtl'] .lang-switch::after {
    right: auto;
    left: 0.55rem;
  }

  html[dir='rtl'] .lang-switch__select {
    padding: 0.35rem 0.7rem 0.35rem 1.75rem;
  }
</style>

<script>
  import { LOCALE_STORAGE_KEY, DEFAULT_LOCALE, isLocaleCode } from '../i18n/locales';
  import { setLocale } from '../scripts/apply-locale';

  document.querySelectorAll<HTMLSelectElement>('[data-lang-select]').forEach((select) => {
    try {
      const params = new URLSearchParams(window.location.search);
      const fromUrl = params.get('hl') ?? '';
      const stored = isLocaleCode(fromUrl)
        ? fromUrl
        : (localStorage.getItem(LOCALE_STORAGE_KEY) ?? DEFAULT_LOCALE);
      if (isLocaleCode(stored)) select.value = stored;
    } catch {
      select.value = DEFAULT_LOCALE;
    }

    select.addEventListener('change', () => {
      const next = select.value;
      if (isLocaleCode(next)) setLocale(next);
    });
  });
</script>
