---
import {
  DEFAULT_IMAGE_WIDTHS,
  avifSrcSet,
  defaultWebpSrc,
  imageSrcSet,
} from '../utils/responsiveImage';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
  fetchPriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  widths?: readonly number[];
  class?: string;
  desktopOnly?: boolean;
  mobileOnly?: boolean;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchPriority,
  sizes = '(min-width: 1024px) 640px, 100vw',
  widths = DEFAULT_IMAGE_WIDTHS,
  class: className,
  desktopOnly = false,
  mobileOnly = false,
} = Astro.props;

const isRaster = /\.(png|jpe?g|webp|avif)$/i.test(src);
const webpSet = imageSrcSet(src, widths);
const avifSet = avifSrcSet(src, widths);
const gated = desktopOnly || mobileOnly;
const imgSrc = gated
  ? 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'
  : defaultWebpSrc(src, widths);
const pictureMedia = desktopOnly ? '(min-width: 1024px)' : mobileOnly ? '(max-width: 1023px)' : undefined;
---

{
  isRaster ? (
    <picture>
      {avifSet ? (
        <source type="image/avif" srcset={avifSet} sizes={sizes} media={pictureMedia} />
      ) : null}
      {webpSet ? (
        <source type="image/webp" srcset={webpSet} sizes={sizes} media={pictureMedia} />
      ) : null}
      <img
        src={imgSrc}
        srcset={gated ? undefined : webpSet}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding={fetchPriority === 'high' ? 'sync' : 'async'}
        fetchpriority={fetchPriority}
        sizes={sizes}
        class={className}
      />
    </picture>
  ) : (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding={fetchPriority === 'high' ? 'sync' : 'async'}
      fetchpriority={fetchPriority}
      class={className}
    />
  )
}
