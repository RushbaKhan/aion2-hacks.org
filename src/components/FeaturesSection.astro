---
import { t } from '../i18n';
import { featureIcons } from '../data/sectionIcons';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';
import { ROUTES } from '../utils/path';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';

const s = t.features;

const featureHrefs: Record<string, string> = {
  Aimbot: '/aim/',
  'Player ESP': '/esp/',
  'Hero ESP': '/hero/',
  'Ability ESP': '/hero/',
  'Objective ESP': '/obj/',
  Radar: '/radar/',
  'Team Check': '/esp/',
  'Silent Aim': '/aim/',
  Compatibility: ROUTES.status,
};

function isScriptsHero(title: string) {
  return title === 'Aimbot';
}
---

<section id="features" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="features-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader as="h2" eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="features-title" />

    <div
      class="features-bento mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-12 lg:grid-rows-[repeat(6,auto)] lg:items-stretch lg:gap-4"
    >
      {
        s.items.map((item) => {
          const scriptsHero = isScriptsHero(item.title);
          return (
            <article
              class:list={[
                'group flex h-full min-h-0 flex-col overflow-hidden rounded-2xl border border-border bg-card text-left shadow-sm transition-colors hover:border-primary/35',
                item.bento ?? 'sm:col-span-2 lg:col-span-4',
                scriptsHero && 'features-bento-card--scripts',
              ]}
            >
              {
                scriptsHero ? (
                  <>
                    <header class="card-title-band px-5 py-4 sm:px-6 sm:py-5">
                      <div class="flex items-start gap-3">
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/10">
                          <Icon name={featureIcons[item.title] ?? 'crosshair'} size={20} />
                        </span>
                        <div class="min-w-0 space-y-1.5">
                          <p class="font-[family-name:var(--font-heading)] text-lg font-bold leading-tight text-foreground md:text-xl">
                            {item.title}
                          </p>
                          <p class="text-sm font-medium leading-snug text-neutral-600 dark:text-neutral-300">
                            {item.subtitle}
                          </p>
                        </div>
                      </div>
                    </header>

                    <div class="features-bento-scripts__body flex min-h-0 flex-1 flex-col gap-4 px-5 py-4 sm:gap-5 sm:px-6 sm:py-5">
                      <p class="text-sm leading-relaxed text-muted-foreground">{item.desc}</p>

                      {
                        item.bullets && item.bullets.length > 0 && (
                          <ul class="space-y-2.5 text-sm text-muted-foreground">
                            {item.bullets.map((b) => (
                              <li class="flex items-start gap-2.5">
                                <Icon name="check" size={14} class="mt-0.5 shrink-0 text-primary" />
                                <span class="leading-snug">{b}</span>
                              </li>
                            ))}
                          </ul>
                        )
                      }
                    </div>

                    <div class="card-footer-band mt-auto flex flex-wrap items-center gap-2 px-5 py-3 sm:px-6 sm:py-3.5">
                      {item.tags.map((tag) => (
                        <Badge variant="secondary" class="text-[11px]">
                          {tag}
                        </Badge>
                      ))}
                      <a
                        href={featureHrefs[item.title] ?? ROUTES.features}
                        class="feature-guide-link ml-auto inline-flex items-center gap-1 text-xs font-semibold text-primary-accent hover:underline"
                      >
                        {t.ui.openGuide}
                        <Icon name="arrowRight" size={13} />
                      </a>
                    </div>
                  </>
                ) : (
                  <>
                    <header class="card-title-band space-y-2 px-5 py-4 sm:px-6">
                      <div class="flex items-start gap-2.5">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary/10">
                          <Icon name={featureIcons[item.title] ?? 'crosshair'} size={18} />
                        </span>
                        <div class="min-w-0 space-y-1">
                          <p class="font-[family-name:var(--font-heading)] text-base font-bold leading-tight text-foreground md:text-lg">
                            {item.title}
                          </p>
                          <p class="text-sm font-medium leading-snug text-neutral-600 dark:text-neutral-300">
                            {item.subtitle}
                          </p>
                        </div>
                      </div>
                    </header>

                    <div class="flex min-h-0 flex-1 flex-col gap-3 px-5 py-4 sm:px-6">
                      <p class="text-sm leading-relaxed text-muted-foreground">{item.desc}</p>

                      {
                        item.bullets && item.bullets.length > 0 && (
                          <ul class="space-y-2 text-sm text-muted-foreground">
                            {item.bullets.map((b) => (
                              <li class="flex items-start gap-2.5">
                                <Icon name="check" size={14} class="mt-0.5 shrink-0" />
                                <span class="leading-snug">{b}</span>
                              </li>
                            ))}
                          </ul>
                        )
                      }
                    </div>

                    <div class="card-footer-band mt-auto flex flex-wrap items-center gap-1.5 px-5 py-3 sm:px-6">
                      {item.tags.map((tag) => (
                        <Badge variant="secondary" class="text-[11px]">
                          {tag}
                        </Badge>
                      ))}
                      <a
                        href={featureHrefs[item.title] ?? ROUTES.features}
                        class="feature-guide-link ml-auto inline-flex items-center gap-1 text-xs font-semibold text-primary-accent hover:underline"
                      >
                        {t.ui.openGuide}
                        <Icon name="arrowRight" size={13} />
                      </a>
                    </div>
                  </>
                )
              }
            </article>
          );
        })
      }
    </div>

    <div class="mt-10 flex flex-wrap justify-start gap-3 lg:justify-center">
      <Button as="a" href={ROUTES.features} variant="primary">
        {t.ui.viewAllFeatures}
        <Icon name="arrowRight" size={17} />
      </Button>
      <Button as="a" href={ROUTES.store} variant="outline">
        {t.products.viewAll}
      </Button>
      <Button as="a" href={ROUTES.preview} variant="outline">
        {t.ui.previewOverlays}
      </Button>
    </div>
  </div>
</section>
