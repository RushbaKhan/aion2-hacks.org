---
import '../../styles/forum.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ForumDiscussionCard from '../../components/ForumDiscussionCard.astro';
import ForumSidebar from '../../components/ForumSidebar.astro';
import Icon from '../../components/icons/Icon.astro';
import { forumCategories, forumPosts, getForumCategoryKey } from '../../data/forum';
import { forumPostPath, ROUTES } from '../../utils/path';
import { canonicalUrl, resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import { forumCategoryIcons } from '../../data/sectionIcons';

const seo = resolvePageSeo('/forum/');
const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Forum', path: ROUTES.forum }];
const filters = [{ name: 'All topics', key: 'all' }, ...forumCategories.map((category) => ({
  name: category.name,
  key: getForumCategoryKey(category.name),
}))];
const sorted = [...forumPosts].sort((a, b) => b.upvotes - a.upvotes);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: 'Aion 2 Hacks Community Forum',
      description: seo.description,
      url: ROUTES.forum,
    }),
    breadcrumbSchema(breadcrumbs),
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: 'Aion 2 Hacks Community Forum discussions',
      numberOfItems: forumPosts.length,
      itemListElement: sorted.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: post.title,
        url: canonicalUrl(forumPostPath(post.slug)),
      })),
    },
  ]}
>
  <section class="forum-page">
    <div class="section-shell">
      <Breadcrumbs items={breadcrumbs} />

      <div class="forum-hero">
        <div class="forum-hero__copy-wrap">
          <p class="section-header__eyebrow">Aion 2 community forum</p>
          <h1>Aion 2 <span>Community Forum</span></h1>
          <p class="forum-hero__copy">
            Practical answers on <a href={ROUTES.features}>ESP</a>, <a href="/radar/">radar</a>,
            <a href={ROUTES.status}>compatibility patches</a>, and <a href={ROUTES.setup}>Windows PC setup</a>.
          </p>
        </div>
        <a class="forum-create" href={ROUTES.blog}>Explore the guides</a>
      </div>

      <div class="forum-layout">
        <div class="forum-main">
          <div class="forum-toolbar">
            <div class="forum-sort" role="group" aria-label="Sort discussions">
              <button type="button" class="is-active" data-forum-sort="popular">Popular</button>
              <button type="button" data-forum-sort="latest">Latest</button>
              <button type="button" data-forum-sort="discussed">Most discussed</button>
            </div>
            <label class="forum-search">
              <Icon name="search" size={15} />
              <input type="search" placeholder="Search discussions…" aria-label="Search discussions" data-listing-search />
            </label>
            <p class="forum-online">
              <i></i>
              <span data-forum-visible-count>{forumPosts.length} discussions</span>
            </p>
          </div>

          <nav class="forum-category-filters" aria-label="Forum topics">
            {filters.map((filter) => (
              <button
                type="button"
                class:list={[filter.key === 'all' && 'is-active']}
                data-forum-filter={filter.key}
              >
                {filter.key !== 'all' && (
                  <Icon name={forumCategoryIcons[filter.name] ?? 'messageCircle'} size={13} />
                )}
                {filter.name}
              </button>
            ))}
          </nav>

          <p class="forum-results-count" data-forum-results-label>{forumPosts.length} guide discussions</p>

          <div id="forum-grid" class="forum-post-list" data-forum-list>
            {sorted.map((post, index) => (
              <ForumDiscussionCard post={post} index={index} />
            ))}
          </div>

          <p id="forum-empty" class="forum-empty" hidden>
            No discussions match. Try another search or topic.
          </p>
        </div>

        <ForumSidebar />
      </div>
    </div>
  </section>

  <script>
    import { initForumIndexFilters } from '../../scripts/forum-index.ts';
    import { initForumVotes } from '../../scripts/forum-votes.ts';

    const boot = () => {
      initForumIndexFilters('No discussions match. Try another search or topic.');
      initForumVotes();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  </script>
</BaseLayout>
