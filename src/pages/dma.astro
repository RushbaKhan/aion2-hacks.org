---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProductPage } from '../data/products';
import { EXTRA_SHOTS } from '../data/screenshots';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, productSchema } from '../utils/schema';
import ProductDetail from '../components/ProductDetail.astro';
import { displayImageType, webpSrc } from '../utils/responsiveImage';
import { ROUTES } from '../utils/path';

const seo = resolvePageSeo('/dma/');
const product = getProductPage('dma')!;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Store', path: ROUTES.store },
  { name: 'Cloud DMA', path: ROUTES.dma },
];
const heroShot = EXTRA_SHOTS.dma;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={heroShot.src}
  ogImageAlt={heroShot.alt}
  jsonLd={[
    productSchema({
      name: product.title,
      description: product.desc,
      url: ROUTES.dma,
      offerUrl: product.buyUrl,
      image: product.images[0]?.src,
      sku: product.slug,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={webpSrc(heroShot.src, 400)}
    type={displayImageType(heroShot.src)}
    fetchpriority="high"
  />
  <ProductDetail product={product} breadcrumbs={breadcrumbs} />
</BaseLayout>
