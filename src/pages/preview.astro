---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProductScreenshotGallery from '../components/ProductScreenshotGallery.astro';
import { heroSlides, productPages } from '../data/products';
import { ROUTES } from '../utils/path';
import { Button } from '@/components/starwind/button';
import Icon from '../components/icons/Icon.astro';

const seo = resolvePageSeo('/preview/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Preview', path: '/preview/' },
];
const product = productPages[0]!;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/preview/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6 max-w-3xl">
        <SectionHeader
          eyebrow="Preview"
          title="The Isle hacks preview"
          desc="Look through interface, player information, ESP, and radar options before choosing a monthly or lifetime plan."
          titleId="preview-page-title"
        />
      </div>

      <div class="mt-10">
        <ProductScreenshotGallery images={heroSlides} id="preview-gallery" />
      </div>

      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {product.features.map((feature) => (
          <li class="rounded-xl border border-border bg-card px-4 py-3 text-sm">{feature}</li>
        ))}
      </ul>

      <p class="mt-8 max-w-3xl text-sm leading-relaxed text-muted-foreground">
        Preview images illustrate the listed overlay categories. Confirm the current feature list and status before purchase—
        game updates can change what a build can display.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button as="a" href={ROUTES.store} variant="primary">
          View store
          <Icon name="arrowRight" size={17} />
        </Button>
        <Button as="a" href={ROUTES.features} variant="outline">Read features</Button>
      </div>
    </div>
  </section>
</BaseLayout>
