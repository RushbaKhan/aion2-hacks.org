---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { ROUTES } from '../utils/path';
import { Button } from '@/components/starwind/button';
import Icon from '../components/icons/Icon.astro';

const seo = resolvePageSeo('/features/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Features', path: '/features/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/features/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="mt-6 text-3xl font-bold uppercase tracking-tight md:text-4xl">AION 2 Features</h1>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted-foreground">
        This page lists AION 2 modules from the current product listing. Compare plans on the
        <a href={ROUTES.store}>store</a>, look at screenshots on the <a href={ROUTES.preview}>preview</a>,
        and read the <a href="/cheats/">AION 2 cheats overview</a> if you want a starting map.
        Confirm <a href={ROUTES.status}>status</a> after an AION 2 client update.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button as="a" href={ROUTES.store} variant="primary">
          View store
          <Icon name="arrowRight" size={17} />
        </Button>
        <Button as="a" href={ROUTES.status} variant="outline">Check status</Button>
        <Button as="a" href={ROUTES.preview} variant="outline">Preview overlays</Button>
      </div>
    </div>
  </section>
  <FeaturesSection />
</BaseLayout>
