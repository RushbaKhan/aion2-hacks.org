---
import '../styles/blog-pages.css';
import '../styles/site-search.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/icons/Icon.astro';
import { getSearchIndex } from '../data/searchIndex';
import { ROUTES } from '../utils/path';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../utils/schema';
import { Button } from '@/components/starwind/button';
import { Card, CardContent, CardTitle } from '@/components/starwind/card';

const seo = resolvePageSeo(ROUTES.search);
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Search', path: ROUTES.search },
];
const index = getSearchIndex();
const types = ['all', 'article', 'discussion', 'faq', 'page'] as const;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  noindex
  jsonLd={[
    collectionPageSchema({
      name: 'Search AION 2 Cheats',
      description: seo.description,
      url: ROUTES.search,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </section>

  <section class="border-y border-border bg-muted/20 py-12 md:py-16" aria-labelledby="search-title">
    <div class="mx-auto max-w-6xl px-5">
      <header class="section-header max-w-2xl">
        <p class="section-header__eyebrow">Search</p>
        <h1 id="search-title" class="section-header__title">Search AION 2 Cheats</h1>
        <p class="section-header__subtitle">
          Look through articles, forum discussions, FAQ answers, and site pages.
        </p>
      </header>

      <form class="mt-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between" action={ROUTES.search} method="get" role="search">
        <label class="listing-search max-w-xl">
          <Icon name="search" size={16} />
          <input type="search" name="q" placeholder="Search articles, forum, FAQ…" aria-label="Search AION 2 Cheats" data-page-search />
        </label>
        <nav class="flex gap-2 overflow-x-auto pb-1" aria-label="Result types">
          {types.map((type) => (
            <button
              type="button"
              class="blog-filter inline-flex shrink-0 items-center rounded-full border border-border bg-background px-4 py-2 text-sm font-medium capitalize shadow-xs hover:bg-muted"
              data-search-type={type}
              aria-pressed={type === 'all' ? 'true' : 'false'}
            >
              {type === 'all' ? 'All results' : type}
            </button>
          ))}
        </nav>
      </form>

      <p class="mt-6 text-sm text-muted-foreground" data-search-count>{index.length} results</p>

      <div id="search-grid" class="mt-8 grid gap-6 md:grid-cols-2">
        {index.map((entry) => (
          <Card
            size="sm"
            class="blog-card border border-border shadow-xs"
            data-search-card
            data-search={`${entry.title} ${entry.desc} ${entry.type}`}
            data-type={entry.type.toLowerCase()}
          >
            <CardContent class="flex flex-col gap-2 p-5">
              <p class="text-[0.625rem] font-bold uppercase tracking-[0.08em] text-primary">{entry.type}</p>
              <CardTitle class="text-base font-semibold normal-case leading-snug">
                <a href={entry.href} class="hover:text-primary hover:underline">{entry.title}</a>
              </CardTitle>
              <p class="line-clamp-2 text-sm text-muted-foreground">{entry.desc}</p>
              <a href={entry.href} class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-primary">
                Open
                <Icon name="arrowRight" size={14} />
              </a>
            </CardContent>
          </Card>
        ))}
      </div>

      <p id="search-empty" class="mt-10 hidden text-muted-foreground" role="status">
        No matches. Try ESP, radar, plans, or compatibility.
      </p>

      <div class="mt-12 flex flex-wrap gap-3">
        <Button as="a" href={ROUTES.blog} variant="outline">Browse blog</Button>
        <Button as="a" href={ROUTES.forum} variant="outline">Browse forum</Button>
        <Button as="a" href={ROUTES.faq} variant="outline">Read FAQ</Button>
      </div>
    </div>
  </section>

  <script>
    import { textMatches } from '../scripts/search-match';

    const input = document.querySelector<HTMLInputElement>('[data-page-search]');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-search-card]')];
    const empty = document.getElementById('search-empty');
    const count = document.querySelector<HTMLElement>('[data-search-count]');
    const typeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-search-type]')];
    const params = new URLSearchParams(window.location.search);
    if (input && params.get('q')) input.value = params.get('q') ?? '';

    const requestedType = (params.get('type') ?? 'all').toLowerCase();
    typeButtons.forEach((button) => {
      const active = (button.dataset.searchType ?? 'all') === requestedType;
      button.setAttribute('aria-pressed', String(active));
      button.toggleAttribute('data-active', active);
    });

    const apply = () => {
      const query = input?.value.trim().toLocaleLowerCase() ?? '';
      const type =
        typeButtons.find((button) => button.getAttribute('aria-pressed') === 'true')?.dataset.searchType ?? 'all';
      let visible = 0;
      cards.forEach((card) => {
        const haystack = card.getAttribute('data-search') ?? '';
        const cardType = card.getAttribute('data-type') ?? '';
        const matchType = type === 'all' || cardType === type;
        const matchQuery = textMatches(haystack, query);
        const show = matchType && matchQuery;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });
      if (count) count.textContent = `${visible} ${visible === 1 ? 'result' : 'results'}${query ? ` for “${query}”` : ''}`;
      empty?.classList.toggle('hidden', visible > 0);
    };

    input?.addEventListener('input', () => {
      const url = new URL(window.location.href);
      const query = input.value.trim();
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      window.history.replaceState({}, '', url);
      apply();
    });

    typeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        typeButtons.forEach((item) => {
          const active = item === button;
          item.setAttribute('aria-pressed', String(active));
          item.toggleAttribute('data-active', active);
        });
        const url = new URL(window.location.href);
        const type = button.dataset.searchType ?? 'all';
        if (type === 'all') url.searchParams.delete('type');
        else url.searchParams.set('type', type);
        window.history.replaceState({}, '', url);
        apply();
      });
    });

    apply();
  </script>
</BaseLayout>
