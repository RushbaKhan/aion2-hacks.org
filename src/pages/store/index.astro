---
import '../../styles/product-cheat-page.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { productHub, productPages } from '../../data/products';
import { screenshotByRank } from '../../data/screenshots';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, productSchema } from '../../utils/schema';
import ProductDetail from '../../components/ProductDetail.astro';
import { webpSrc } from '../../utils/responsiveImage';

const seo = resolvePageSeo('/store/');
const product = productPages[0]!;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Store', path: productHub.path },
];
const heroShot = screenshotByRank(0);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={heroShot.src}
  ogImageAlt={heroShot.alt}
  jsonLd={[
    productSchema({
      name: product.title,
      description: product.desc,
      url: productHub.path,
      offerUrl: product.buyUrl,
      image: product.images[0]?.src,
      sku: product.slug,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={webpSrc(heroShot.src, 400)}
    type="image/webp"
    media="(max-width: 1023px)"
    fetchpriority="high"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href={webpSrc(heroShot.src, 640)}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <ProductDetail product={product} breadcrumbs={breadcrumbs} />
</BaseLayout>
