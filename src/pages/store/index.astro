---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { productHub, productPages, utilityPages } from '../../data/products';
import { screenshotByRank } from '../../data/screenshots';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, itemListSchema, productSchema } from '../../utils/schema';
import { productPath } from '../../utils/path';
import ProductDetail from '../../components/ProductDetail.astro';
import { displayImageType, webpSrc } from '../../utils/responsiveImage';

const seo = resolvePageSeo('/store/');
const product = productPages[0]!;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Store', path: productHub.path },
];
const heroShot = screenshotByRank(0);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={heroShot.src}
  ogImageAlt={heroShot.alt}
  jsonLd={[
    productSchema({
      name: product.title,
      description: product.desc,
      url: productHub.path,
      offerUrl: product.buyUrl,
      image: product.images[0]?.src,
      sku: product.slug,
    }),
    itemListSchema([
      { name: product.title, url: productHub.path },
      ...utilityPages.map((item) => ({ name: item.title, url: productPath(item.slug) })),
    ]),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={webpSrc(heroShot.src, 400)}
    type={displayImageType()}
    fetchpriority="high"
  />
  <ProductDetail product={product} breadcrumbs={breadcrumbs} />
</BaseLayout>
