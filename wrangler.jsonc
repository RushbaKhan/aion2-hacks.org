{
  "name": "aion2-hacks-org",
  "main": "workers/seo-edge.js",
  "compatibility_date": "2026-10-10",
  "build": {
    "command": "npm run build:cf"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*"
    ]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
