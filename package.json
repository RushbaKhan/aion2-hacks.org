{
  "name": "aion2hacks-org",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/optimize-images.mjs && astro build && node scripts/prune-dist-images.mjs && node scripts/finalize-sitemap.mjs && node scripts/indexnow.mjs",
    "build:cf": "astro build && node scripts/prune-dist-images.mjs && node scripts/finalize-sitemap.mjs && node scripts/indexnow.mjs",
    "deploy": "npm run build:cf && wrangler deploy",
    "preview": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "astro": "astro",
    "optimize:images": "node scripts/optimize-images.mjs",
    "postinstall": "node scripts/cf-postinstall.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/outfit": "^5.3.0",
    "@lucide/astro": "^1.48.0",
    "@starwind-ui/astro": "^1.2.1",
    "@tabler/icons": "^3.48.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "lenis": "^1.3.26",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
